
@page "/"
<PageTitle>Panel principal</PageTitle>

<h1>Panel principal</h1>
<p>Sistema de demostración de objetos avanzados de bases de datos.</p>

<div class="row g-4 mt-2">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Vistas y Funciones</h5>
                <p class="card-text">Evidencia de vistas estándar, indexadas y funciones escalares/tabla.</p>
                <a href="vistas" class="btn btn-primary">Ver Vistas</a>
                <a href="funciones" class="btn btn-secondary ms-2">Ver Funciones</a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Procedimientos y Triggers</h5>
                <p class="card-text">Ejecución de procesos masivos (cursores) y auditoría (causa y efecto).</p>
                <a href="procedimientos" class="btn btn-primary">Procedimientos</a>
                <a href="triggers" class="btn btn-secondary ms-2">Triggers</a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Consultas SQL</h5>
                <p class="card-text">Ejecución de JOINs, teoría de conjuntos y operadores especiales.</p>
                <a href="consultas" class="btn btn-primary">Ir a Consultas</a>
            </div>
        </div>
    </div>
</div>
