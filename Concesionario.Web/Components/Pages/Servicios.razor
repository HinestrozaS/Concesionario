
@page "/servicios"

<PageTitle>Servicios</PageTitle>

<div class="container-fluid py-4">

    <h1>Gestión de servicios</h1>
    <p class="text-secondary">
        Administración de los servicios ofrecidos por el taller.
    </p>

    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <h5 class="mb-0">Información del servicio</h5>
        </div>

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-8">
                    <label class="form-label">Nombre del servicio</label>
                    <input class="form-control" type="text"
                           placeholder="Ingrese el nombre del servicio" />
                </div>

                <div class="col-md-4">
                    <label class="form-label">Tarifa por hora</label>
                    <input class="form-control" type="number"
                           min="0" step="0.01"
                           placeholder="0.00" />
                </div>

            </div>

            <div class="mt-4">
                <button class="btn btn-primary" disabled>
                    Guardar servicio
                </button>

                <small class="text-secondary ms-2">
                    Pendiente de conexión con la API.
                </small>
            </div>

        </div>
    </div>

    <div class="card shadow-sm">

        <div class="card-header">
            <h5 class="mb-0">Servicios registrados</h5>
        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-striped table-hover">

                    <thead>
                        <tr>
                            <th>Identificador</th>
                            <th>Nombre del servicio</th>
                            <th>Tarifa por hora</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        <tr>
                            <td colspan="4"
                                class="text-center text-secondary">
                                Los servicios aparecerán aquí cuando conectemos la API.
                            </td>
                        </tr>
                    </tbody>

                </table>

            </div>
        </div>
    </div>

</div>
