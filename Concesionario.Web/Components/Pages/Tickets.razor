
@page "/tickets"

<PageTitle>Tickets de servicio</PageTitle>

<div class="container-fluid py-4">

    <h1>Tickets de servicio</h1>

    <p class="text-secondary">
        Registro y consulta de los vehículos que ingresan al taller.
    </p>

    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <h5 class="mb-0">Registrar ticket de servicio</h5>
        </div>

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-6">
                    <label class="form-label">Cliente</label>
                    <select class="form-select">
                        <option value="">Seleccionar cliente</option>
                    </select>
                    <small class="text-secondary">
                        Se consultarán los clientes registrados.
                    </small>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Vehículo</label>
                    <select class="form-select">
                        <option value="">Seleccionar vehículo</option>
                    </select>
                    <small class="text-secondary">
                        Se identificarán los vehículos por su número de serie.
                    </small>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Fecha de entrada</label>
                    <input class="form-control" type="date" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Fecha de salida</label>
                    <input class="form-control" type="date" />
                    <small class="text-secondary">
                        Campo opcional.
                    </small>
                </div>

            </div>

            <div class="mt-4">
                <button class="btn btn-primary" disabled>
                    Registrar ticket
                </button>

                <small class="text-secondary ms-2">
                    Pendiente de conexión con la API.
                </small>
            </div>

        </div>
    </div>

    <div class="card shadow-sm">

        <div class="card-header">
            <h5 class="mb-0">Tickets registrados</h5>
        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-striped table-hover">

                    <thead>
                        <tr>
                            <th>Número de ticket</th>
                            <th>Cliente</th>
                            <th>Número de serie</th>
                            <th>Fecha de entrada</th>
                            <th>Fecha de salida</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        <tr>
                            <td colspan="6"
                                class="text-center text-secondary">
                                Los tickets aparecerán aquí cuando conectemos la API.
                            </td>
                        </tr>
                    </tbody>

                </table>

            </div>
        </div>
    </div>

</div>
