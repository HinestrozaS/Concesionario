@page "/procedimientos"
@using Concesionario.Contracts
@using Concesionario.WEB.Services
@inject ConcesionarioApiClient Api

<h3>Procedimientos almacenados</h3>
@if (error != null) { <div class="alert alert-danger">@error</div> }
@if (ok != null) { <div class="alert alert-success">@ok</div> }
<div class="card mb-4"><div class="card-body">
<h5>sp_AgregarTrabajo <small class="text-muted">(validaciones +
TRY...CATCH)</small></h5>
<div class="row g-2 align-items-end">
<div class="col-auto"><label class="form-label">Ticket</label>
<select class="form-select" @bind="idTicketTrabajo">
<option value="0">-- elige --</option>
@foreach (var t in tickets.Where(x => !x.Facturado)) {
<option value="@t.IdTicket">#@t.IdTicket · @t.Cliente · @t.NumSerie</option>
}
</select></div>
<div class="col-auto"><label class="form-label">Servicio</label>
<select class="form-select" @bind="trabajo.IdServicio">
<option value="0">-- elige --</option>
@foreach (var s in servicios) { <option
value="@s.IdServicio">@s.NomServicio</option> }
</select></div>
<div class="col-auto"><label class="form-label">Horas</label><input
type="number" step="0.25" class="form-control"
@bind="trabajo.HorasTrabajadas" /></div>
<div class="col-auto"><label class="form-label">Descripción</label>
<input class="form-control" @bind="trabajo.Descripcion" /></div>
<div class="col-auto"><button class="btn btn-primary"
@onclick="AgregarTrabajo">Agregar</button></div>
</div>
</div></div>
<div class="card mb-4"><div class="card-body">
<h5>sp_RegistrarFacturaTicket <small class="text-muted">(transacción +
parámetro OUTPUT)</small></h5>
<div class="row g-2 align-items-end">
<div class="col-auto"><label class="form-label">Ticket</label>
<select class="form-select" @bind="idTicketFactura">
<option value="0">-- elige --</option>
@foreach (var t in tickets.Where(x => !x.Facturado)) {
<option value="@t.IdTicket">#@t.IdTicket · @t.Cliente · @t.NumSerie</option>
}
</select></div>
<div class="col-auto"><label class="form-label">Asesor</label>
<select class="form-select" @bind="idAsesorFactura">
<option value="0">-- elige --</option>
@foreach (var a in asesores) { <option
value="@a.IdAsesor">@a.NombreCompleto</option> }
</select></div>
<div class="col-auto"><button class="btn btn-primary"
@onclick="Facturar">Facturar</button></div>
</div>
</div></div>
<div class="card mb-4"><div class="card-body">
<h5>sp_AjustarTarifasServicios <small class="text-muted">(@@ROWCOUNT)
</small></h5>
<div class="row g-2 align-items-end">
<div class="col-auto"><label class="form-label">Servicio</label>
<select class="form-select" @bind="ajuste.IdServicio">
<option value="">Todos los servicios</option>
@foreach (var s in servicios) { <option
value="@s.IdServicio">@s.NomServicio</option> }
</select></div>
<div class="col-auto"><label class="form-label">Porcentaje</label>
<input type="number" class="form-control" @bind="ajuste.Porcentaje" /></div>
<div class="col-auto"><button class="btn btn-primary"
@onclick="Ajustar">Aplicar</button></div>
</div>
</div></div>
<div class="card"><div class="card-body">
<h5>sp_FacturarTicketsPendientesCursor <small class="text-muted">(recorre
los tickets con un CURSOR)</small></h5>
<div class="row g-2 align-items-end">
<div class="col-auto"><label class="form-label">Asesor</label>
<select class="form-select" @bind="idAsesorCursor">
<option value="0">-- elige --</option>
@foreach (var a in asesores) { <option
value="@a.IdAsesor">@a.NombreCompleto</option> }
</select></div>
<div class="col-auto"><button class="btn btn-primary"
@onclick="Procesar">Facturar pendientes</button></div>
</div>
@if (cursor != null)
{
<p class="mt-3">Facturas generadas:
<strong>@cursor.Facturadas</strong></p>
<table class="table table-sm table-striped">
<thead><tr><th>Factura</th><th>Ticket</th><th>Cliente</th>
    <th>Vehículo</th><th>Total</th></tr></thead>
<tbody>
@foreach (var f in cursor.Facturas)
{
<tr><td>@f.IdFactura</td><td>@f.IdTicket</td>
<td>@f.Cliente</td><td>@f.NumSerie</td><td>@f.Total.ToString("N2")</td></tr>
}
</tbody>
</table>
}
</div></div>
@code {
private List<TicketDto> tickets = new();
private List<AsesorDto> asesores = new();
private List<ServicioDto> servicios = new();
private int idTicketTrabajo, idTicketFactura, idAsesorFactura,
idAsesorCursor;
private TrabajoCrearDto trabajo = new() { HorasTrabajadas = 1 };
private AjusteTarifasDto ajuste = new() { Porcentaje = 5 };
private ResultadoCursorDto? cursor;
private string? error, ok;
protected override async Task OnInitializedAsync() => await
CargarListas();
private async Task CargarListas()
{
var e = await Util.Intentar(async () =>
{
tickets = await Api.Tickets();
asesores = await Api.Asesores();
servicios = await Api.Servicios();
});
error ??= e;
}
private async Task AgregarTrabajo()
{
ok = null;
error = await Util.Intentar(async () => { var r = await
Api.AgregarTrabajo(idTicketTrabajo, trabajo); ok = $"Trabajo creado con id{r.Id}."; });
}
private async Task Facturar()
{
        ok = null;
        error = await Util.Intentar(async () =>
        {
        var r = await Api.FacturarTicket(new FacturaCrearDto { IdTicket =
        idTicketFactura, IdAsesor = idAsesorFactura });
        ok = $"Factura creada con id {r.Id}.";
        });
        await CargarListas();
        }
        private async Task Ajustar()
        {
        ok = null;
        error = await Util.Intentar(async () => { var r = await
        Api.AjustarTarifas(ajuste); ok = $"Servicios actualizados: {r.Filas}."; });
        }
        private async Task Procesar()
        {
        ok = null;
        error = await Util.Intentar(async () =>
        {
        cursor = await Api.FacturarPendientes(idAsesorCursor);
        ok = $"El cursor generó {cursor.Facturadas} factura(s).";
        });
        await CargarListas();
        }
}
