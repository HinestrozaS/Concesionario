
@page "/repuestos"

<PageTitle>Repuestos</PageTitle>

<div class="container-fluid py-4">

    <h1>Gestión de repuestos</h1>
    <p class="text-secondary">
        Administración de los repuestos utilizados en el taller.
    </p>

    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <h5 class="mb-0">Información del repuesto</h5>
        </div>

        <div class="card-body">

            <div class="row g-3">

                <div class="col-12">
                    <label class="form-label">Descripción del repuesto</label>
                    <textarea class="form-control" rows="3"
                              placeholder="Ingrese la descripción del repuesto">
                    </textarea>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Precio de compra</label>
                    <input class="form-control" type="number"
                           min="0" step="0.01"
                           placeholder="0.00" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Precio de venta</label>
                    <input class="form-control" type="number"
                           min="0" step="0.01"
                           placeholder="0.00" />
                </div>

            </div>

            <div class="mt-4">
                <button class="btn btn-primary" disabled>
                    Guardar repuesto
                </button>

                <small class="text-secondary ms-2">
                    Pendiente de conexión con la API.
                </small>
            </div>

        </div>
    </div>

    <div class="card shadow-sm">

        <div class="card-header">
            <h5 class="mb-0">Repuestos registrados</h5>
        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-striped table-hover">

                    <thead>
                        <tr>
                            <th>Identificador</th>
                            <th>Descripción</th>
                            <th>Precio de compra</th>
                            <th>Precio de venta</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        <tr>
                            <td colspan="5"
                                class="text-center text-secondary">
                                Los repuestos aparecerán aquí cuando conectemos la API.
                            </td>
                        </tr>
                    </tbody>

                </table>

            </div>
        </div>
    </div>

</div>
