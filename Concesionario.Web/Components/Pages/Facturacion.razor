
@page "/facturacion"

<PageTitle>Facturación</PageTitle>

<div class="container-fluid py-4">

    <h1>Facturación</h1>

    <p class="text-secondary">
        Consulta y gestión de las facturas generadas por los servicios del taller.
    </p>

    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <h5 class="mb-0">Consultar factura</h5>
        </div>

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-6">
                    <label class="form-label">Ticket de servicio</label>
                    <select class="form-select">
                        <option value="">Seleccionar ticket</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Asesor</label>
                    <select class="form-select">
                        <option value="">Seleccionar asesor</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Fecha de venta</label>
                    <input class="form-control" type="date" />
                </div>

            </div>

            <div class="mt-4">
                <button class="btn btn-primary" disabled>
                    Generar factura
                </button>

                <small class="text-secondary ms-2">
                    Pendiente de conexión con la API.
                </small>
            </div>

        </div>
    </div>

    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <h5 class="mb-0">Detalle de la factura</h5>
        </div>

        <div class="card-body">

            <h6>Trabajos realizados</h6>

            <div class="table-responsive mb-4">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Servicio</th>
                            <th>Horas</th>
                            <th>Tarifa por hora</th>
                            <th>Subtotal</th>
                        </tr>
                    </thead>

                    <tbody>
                        <tr>
                            <td colspan="4" class="text-center text-secondary">
                                Los trabajos aparecerán al consultar la factura.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <h6>Repuestos utilizados</h6>

            <div class="table-responsive mb-4">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Repuesto</th>
                            <th>Cantidad</th>
                            <th>Precio unitario</th>
                            <th>Subtotal</th>
                        </tr>
                    </thead>

                    <tbody>
                        <tr>
                            <td colspan="4" class="text-center text-secondary">
                                Los repuestos aparecerán al consultar la factura.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-end">
                <div style="min-width: 260px;">
                    <div class="d-flex justify-content-between mb-2">
                        <span>Total de trabajos:</span>
                        <strong>Por calcular</strong>
                    </div>

                    <div class="d-flex justify-content-between mb-2">
                        <span>Total de repuestos:</span>
                        <strong>Por calcular</strong>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between">
                        <h5>Total:</h5>
                        <h5>Por calcular</h5>
                    </div>
                </div>
            </div>

            <p class="text-secondary mt-3 mb-0">
                Los valores se calcularán con la información de los trabajos
                y repuestos asociados al ticket.
            </p>

        </div>
    </div>

    <div class="card shadow-sm">

        <div class="card-header">
            <h5 class="mb-0">Facturas registradas</h5>
        </div>

        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-striped table-hover">

                    <thead>
                        <tr>
                            <th>Número de factura</th>
                            <th>Fecha de venta</th>
                            <th>Asesor</th>
                            <th>Ticket relacionado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        <tr>
                            <td colspan="5" class="text-center text-secondary">
                                Las facturas aparecerán aquí cuando conectemos la API.
                            </td>
                        </tr>
                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>
