@page "/login"
@using Concesionario.Contracts
@using Concesionario.WEB.Services
@inject ConcesionarioApiClient Api


<h3>Seguridad: contraseñas con hash (SHA2_256 + sal)</h3>
@if (error != null) { <div class="alert alert-danger">@error</div> }
@if (ok != null) { <div class="alert alert-success">@ok</div> }
<div class="row g-2" style="max-width:640px">
<div class="col"><label class="form-label">Usuario</label><input
class="form-control" @bind="datos.Username" /></div>
<div class="col"><label class="form-label">Contraseña</label><input
type="password" class="form-control" @bind="datos.Password" /></div>
</div>
<div class="mt-3">
<button class="btn btn-secondary me-2"
@onclick="Registrar">Registrar</button>
<button class="btn btn-primary" @onclick="Ingresar">Ingresar</button>
</div>
<p class="text-muted mt-3">
    En la base de datos solo queda el hash con sal.
    Míralo en SSMS: <code>SELECT * FROM UsuariosSystem</code>.
</p>
@code {
    private LoginDto datos = new();
    private string? error, ok;
    private async Task Registrar()
    {
        ok = null;
        error = await Util.Intentar(async () =>
        {
            await Api.Registrar(datos);
            ok = "Usuario registrado.";
        });
    }
    private async Task Ingresar()
    {
        ok = null;
        error = await Util.Intentar(async () =>
        {
            var valido = await Api.Ingresar(datos);
            if (valido) ok = "Credenciales correctas.";
            else throw new
    ApiException("Usuario o contraseña incorrectos.");
        });
    }
}

